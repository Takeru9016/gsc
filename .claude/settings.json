{
  "model": "claude-sonnet-4-6",
  "defaultMode": "acceptEdits",

  "permissions": {
    "allow": [
      "Bash(pnpm:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git status)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(node:*)",
      "Bash(which:*)",
      "Bash(echo:*)",
      "Bash(ls:*)",
      "Bash(cat .env.example)",
      "Bash(mkdir:*)",
      "Bash(touch:*)"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(cat .env*)",
      "Bash(cat .env.local)",
      "Write(.env)",
      "Write(.env.local)",
      "Write(components/ui/*)",
      "Write(src/components/ui/*)"
    ]
  },

  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm biome check --write \"$FILE\" 2>&1 | tail -3"
          },
          {
            "type": "command",
            "command": "pnpm tsc --noEmit 2>&1 | tail -8"
          }
        ]
      }
    ]
  },

  "env": {
    "CLAUDE_CODE_MAX_OUTPUT_TOKENS": "8192"
  }
}
